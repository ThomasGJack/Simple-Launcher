{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Launcher",
  "version": "26.429.7",
  "identifier": "com.simplelauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Simple Launcher",
        "width": 1400,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Launcher multi-jeux",
    "longDescription": "Simple Launcher — un launcher Windows multi-jeux modulaire avec auto-update, comptes Discord, et page custom par jeu.",
    "publisher": "Simple Launcher",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "displayLanguageSelector": false,
        "languages": [
          "French"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://simplelaunche.web.app/launcher/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0N0RDMTE2QzVFOTJEMzEKUldReExlbkZGc0Y5eEt5aWplTTlBNy94cWs0VmFGYTh0bkhtaWF3ZDcxOE9CZWl1SHNaT21yd1IK"
    }
  }
}
