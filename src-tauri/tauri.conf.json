{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Launcher",
  "version": "26.506.11",
  "identifier": "com.simplelauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Simple Launcher",
        "width": 1400,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Simple Launcher Overlay",
        "url": "/overlay.html",
        "width": 420,
        "height": 600,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "toasts",
        "title": "Simple Launcher Toasts",
        "url": "/toasts.html",
        "width": 360,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": false,
        "resizable": false,
        "fullscreen": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "x": 100,
        "y": 100
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "shortDescription": "Launcher multi-jeux",
    "longDescription": "Simple Launcher — un launcher Windows multi-jeux modulaire avec auto-update, comptes Discord, et page custom par jeu.",
    "publisher": "Simple Launcher",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
