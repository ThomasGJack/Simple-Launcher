rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        request.auth.uid in ['discord_306118713537462273'];
    }

    // Authenticated users can read game assets, admins can write
    match /modules/{moduleId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Users can manage their own avatar
    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Personal shortcut assets — owner-only
    match /users/{uid}/shortcuts/{shortcutId}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Per-user crew uploads (images attached to chat messages). Public
    // read so other crew members can display the inline image; write
    // restricted to the owner so a user can't ghost-upload via someone
    // else's path. The 5 MiB cap is enforced client-side; the
    // contentType check makes sure no executable / archive sneaks in.
    match /users/{uid}/crewUploads/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Custom crew icon images. Public read (so any authed launcher can
    // show the icon in the sidebar / discovery list), write restricted
    // to the crew owner via a Firestore lookup. 2 MiB cap because
    // these get rendered at 12×12 px most of the time — no need for
    // a 5 MB asset.
    match /crews/{crewId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/crews/$(crewId)) &&
        firestore.get(/databases/(default)/documents/crews/$(crewId)).data.ownerUid == request.auth.uid &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/crews/$(crewId)) &&
        firestore.get(/databases/(default)/documents/crews/$(crewId)).data.ownerUid == request.auth.uid;
    }

    // Profile customization assets (banner image, future custom avatar
    // overlay, …). Public read so any launcher user can display the banner
    // on a public profile page; write restricted to the owner.
    match /users/{uid}/profile/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Per-session log files (.sl_logs uploaded as plain text). Owner
    // writes their own; admin reads everyone's for debugging. The daily
    // Cloud Function purges files older than 7 days from this prefix.
    match /users/{uid}/logs/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Screenshots (PNG capturés via F2 dans le launcher). Public read
    // pour qu'un autre user puisse les voir sur la page profile
    // partagée. Write restreint à l'owner. 10 MiB cap suffit pour des
    // PNG haute def 4K.
    match /users/{uid}/screenshots/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

  }
}
