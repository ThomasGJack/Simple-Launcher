rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.uid in ['discord_306118713537462273'];
    }

    // Users — any authed user can read public profiles (community page),
    // only the owner can write.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Playtime per module — private to the owner
      match /playtime/{moduleId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Personal shortcuts — private to the owner
      match /shortcuts/{shortcutId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Minecraft backup metadata — private to the owner. Stores the URL
      // and storage path of a per-instance world/save backup zip; the
      // actual binary lives in Firebase Storage at the path stored here.
      match /minecraftBackups/{backupId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Per-user achievements — private to the owner (write) but readable
      // by any authed user so the public profile page can display badges.
      match /achievements/{achievementId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if false;
      }
    }

    // Modules: any authenticated user can read; admins can write.
    match /modules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Module versions: same.
    match /modules/{moduleId}/versions/{version} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Launcher release info: public read.
    match /launcher/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Server activity stats — every authed launcher client can write the
    // 5-minute player count snapshots (rate-limited client-side) and read
    // the 24h history + all-time peak. Doc IDs are sanitized address keys
    // (no user PII), so this is essentially shared community-curated data.
    match /serverStats/{addressKey} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /snapshots/{snapshotId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // Game invitations — sender writes one doc per ping, recipient (and
    // sender) can read and update its status. Strict membership: only the
    // two parties involved (`fromUid` + `toUid`) can interact with the doc.
    match /invitations/{invitationId} {
      allow read: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid;
      // Only the recipient can accept/decline; only the sender can cancel.
      // Both transitions are funneled through `setInvitationStatus`.
      allow update: if request.auth != null && (
        (resource.data.toUid == request.auth.uid &&
          request.resource.data.status in ["accepted", "declined"]) ||
        (resource.data.fromUid == request.auth.uid &&
          request.resource.data.status == "cancelled")
      );
      // No deletes — the resolved invitation stays as a tiny audit record.
      allow delete: if false;
    }

    // App telemetry / log entries — explicit admin authorization given by
    // the user for the hidden admin logs panel ("panel admin caché que tu
    // auras accès pour voir les bugs"). Each user can write their own
    // logs (uid in body must match auth uid) and read their own logs back;
    // admins can read everything. No update/delete — logs are an
    // immutable audit trail.
    match /logs/{logId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Private 1-on-1 conversations between two launcher users. The doc id
    // is `[uidA, uidB].sort().join("__")` so participants are encoded in
    // the id itself — we extract them and require that the calling user is
    // one of them. Both reads and writes are gated on this membership so
    // a third party can't snoop on a conversation it isn't part of.
    match /conversations/{cid} {
      function isParticipant() {
        return request.auth != null && (
          // Either the auth uid appears in the doc's `participants` array
          // (set on first write by ensureConversation), or, in the no-doc
          // case (very first creation), the cid prefix matches our uid.
          (resource != null && request.auth.uid in resource.data.participants) ||
          (resource == null &&
            (cid.split("__")[0] == request.auth.uid ||
             cid.split("__")[1] == request.auth.uid))
        );
      }
      allow read: if isParticipant();
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isParticipant();
      // Delete is intentionally not allowed — conversation history is durable.

      match /messages/{messageId} {
        function isConvParticipant() {
          let parent = get(/databases/$(database)/documents/conversations/$(cid));
          return request.auth != null && request.auth.uid in parent.data.participants;
        }
        allow read: if isConvParticipant();
        allow create: if isConvParticipant() &&
          request.resource.data.senderUid == request.auth.uid;
        // Don't allow editing or deleting messages — keeps the chat audit
        // trail honest. (Edit/delete UX could be layered on later via a
        // soft-delete flag if needed.)
        allow update, delete: if false;
      }
    }
  }
}
