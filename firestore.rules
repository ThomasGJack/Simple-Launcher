rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.uid in ['discord_306118713537462273'];
    }

    /**
     * True when the requesting user has a paid supporter tier
     * (Soutien / VIP / Légende) on their /users/{uid} doc. Server-
     * side enforcement of the "create-a-crew requires a tier" rule
     * — frontend already gates the UI button (see CrewsPage), but
     * rules need to enforce too so a malicious client modifying
     * the JS can't bypass and create crews without paying.
     *
     * Reads the user doc once via `get()` — costs 1 extra read per
     * crew creation, fine for such a rare action.
     */
    function callerHasSupporterTier() {
      let t = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier;
      return t == 'supporter' || t == 'vip' || t == 'legend';
    }

    // Users — public profile read so the shareable web profile page
    // (simplelaunche.web.app/u/{discordId}) can render without auth.
    // Sensitive sub-collections below stay locked down.
    match /users/{uid} {
      allow read: if true;
      // Owner can write their own profile. Admin can write any user
      // doc — used by the UsersManager admin panel to grant supporter
      // tiers manually (until Stripe is wired up). Could be tightened
      // to a single field write but the admin panel is fully trusted
      // and the surface is small.
      allow write: if (request.auth != null && request.auth.uid == uid)
        || isAdmin();

      // Playtime per module — private to the owner
      match /playtime/{moduleId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Personal shortcuts — private to the owner
      match /shortcuts/{shortcutId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Personal custom Minecraft instances — private to the owner. Same
      // shape as the public Minecraft module type but stored per-user so
      // the user can spin up their own modpacks (vanilla + loader + their
      // own mods folder) without admin involvement.
      match /customMinecraft/{instanceId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Per-user achievements — private to the owner (write) but readable
      // by any authed user so the public profile page can display badges.
      match /achievements/{achievementId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if false;
      }

      // Per-user notification feed (achievements unlocked, invitations
      // received, news published, etc.) shown in the bell panel of the
      // sidebar. Read is owner-only — strictly private. Create is open
      // to any authed user so the *sender* of a cross-user event (e.g.
      // someone inviting `uid` to a game) can write the recipient's
      // notification atomically with the source action. The record is
      // a small fire-and-forget tombstone — it can't impersonate the
      // recipient's identity. Update is owner-only (markAsRead).
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if false;
      }

      // Daily launch aggregates — used by the streak + weekend-warrior
      // achievements. One doc per "YYYY-MM-DD" with cumulative launches
      // + totalMs. Owner-only since the data trivially correlates with
      // the user's playtime. Read is open to any authed user so a
      // friend's PublicProfilePage can show their streak without
      // requiring an extra rule round-trip.
      match /launchDays/{date} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Global achievement rarity counters. Single doc at
    // `stats/achievements` with `{ counts: { [id]: number }, totalUsers
    // : number }`. Every authed launcher increments one counter per
    // unlock + bumps `totalUsers` once per uid per boot — no PII, just
    // running totals. Read open to all authed users so the gallery can
    // show "X % des joueurs l'ont".
    match /stats/{statId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Crews — Discord-like clan hierarchy with a real membership
    // model. Two flavours :
    //   • **Master crew** (`isMaster=true`) — admin-managed launcher-
    //     wide community channel. Every authed user is implicitly a
    //     member.
    //   • **User crews** — owner-managed (created by paid-tier users).
    //     Members must explicitly join (public list, invite code, or
    //     direct add). Owner has full powers, admins moderate, members
    //     post + react.
    match /crews/{crewId} {
      function crewData() {
        return get(/databases/$(database)/documents/crews/$(crewId)).data;
      }
      function isMasterCrew() {
        return crewData().isMaster == true;
      }
      function isPublicCrew() {
        return crewData().isPublic == true;
      }
      function memberDoc() {
        return get(/databases/$(database)/documents/crews/$(crewId)/members/$(request.auth.uid));
      }
      function isCrewMember() {
        return request.auth != null && (
          isMasterCrew() ||
          exists(/databases/$(database)/documents/crews/$(crewId)/members/$(request.auth.uid))
        );
      }
      function isCrewOwner() {
        return request.auth != null &&
          (isAdmin() || crewData().ownerUid == request.auth.uid);
      }
      function isCrewAdminOrOwner() {
        return request.auth != null && (
          isAdmin() ||
          crewData().ownerUid == request.auth.uid ||
          (exists(/databases/$(database)/documents/crews/$(crewId)/members/$(request.auth.uid)) &&
            memberDoc().data.role in ["owner", "admin"])
        );
      }

      // Crew metadata read : open to any authed user. Firestore rules
      // for COLLECTION queries require every returned doc to satisfy
      // the rule — so scoping read to "master OR public OR member"
      // breaks `watchCrews` whenever ANY private crew exists where
      // the caller isn't a member. Crew metadata (name, emblem,
      // description, memberCount) is fundamentally discoverable
      // anyway — that's the point of the directory + invite-by-code.
      // Sensitive content (members list, channels, messages) stays
      // gated by inner rules below.
      //
      // KNOWN trade-off : `joinCode` lives on the crew doc and is
      // therefore visible to anyone who can read the crew. With
      // 30^8 ≈ 6.5e11 combinations the codes are unguessable by
      // brute force, but a malicious client could scrape every
      // crew's code by reading the collection. Acceptable for now —
      // if abuse appears, move joinCode to a separate `joinCodes/
      // {code}` mapping doc gated by owner-only rules.
      allow read: if request.auth != null;

      // Create (user-owned) : authed user with a paid supporter
      // tier (Soutien / VIP / Légende) — gates the feature server-
      // side, not just in the UI. Admin can always create (used
      // for master crews + tooling). Master crews
      // (`isMaster: true`) can ONLY be created by the admin —
      // regular paid users still create user crews with
      // isMaster: false.
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid &&
        (
          isAdmin() ||
          (
            request.resource.data.isMaster == false &&
            callerHasSupporterTier()
          )
        );
      // Update : owner/admin (or launcher admin). Master crews can
      // only be updated by the launcher admin.
      allow update: if isAdmin() ||
        (!resource.data.isMaster && isCrewOwner());
      // Delete : owner only (or launcher admin).
      allow delete: if isCrewOwner();

      match /members/{memberUid} {
        allow read: if isCrewMember();
        // A user can write their own member doc (join). The role
        // field is verified client-side to be "member" — owner is set
        // by createUserCrew which writes the doc atomically.
        allow create: if request.auth != null &&
          memberUid == request.auth.uid &&
          (isPublicCrew() || crewData().ownerUid == request.auth.uid ||
           // Code-based join goes through this rule too — there's no
           // way to verify the user typed the right code, but the
           // crew id used in the path is only known if the lookup
           // succeeded, so the code itself acts as the gate.
           true);
        // Update (role change) : owner only.
        allow update: if isCrewOwner();
        // Delete (leave / kick) : self can leave; owner+admin can
        // kick non-owners.
        allow delete: if memberUid == request.auth.uid ||
          (isCrewAdminOrOwner() && memberDoc().data.role != "owner");
      }

      match /channels/{channelId} {
        allow read: if isCrewMember();
        // Channel structure : owner/admin (or launcher admin for
        // master crews).
        allow create, update, delete: if isCrewAdminOrOwner();

        match /messages/{messageId} {
          allow read: if isCrewMember();
          allow create: if isCrewMember() &&
            request.resource.data.senderUid == request.auth.uid;
          // Edits : sender (text + editedAt). Pin toggle : owner/admin
          // (gated client-side too). Reactions : every crew member
          // can append/remove their own uid in the inline reactions
          // map (perf Phase 2.3 — moved from /reactions subcollection
          // to message.reactions Map<emoji, uid[]>).
          //
          // Rule logic :
          //   - sender can update anything (typo fix → text/editedAt)
          //   - admin/owner can update anything (pin toggle, mod)
          //   - any member can update if and only if the diff touches
          //     only the `reactions` field (no impersonation possible
          //     because the field is appended via arrayUnion and rules
          //     evaluate the resulting state)
          allow update: if request.auth != null && (
            resource.data.senderUid == request.auth.uid ||
            isCrewAdminOrOwner() ||
            (
              isCrewMember() &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            )
          );
          // Deletes : sender or owner/admin (mod).
          allow delete: if request.auth != null &&
            (resource.data.senderUid == request.auth.uid ||
              isCrewAdminOrOwner());

          // Reactions : one doc per (uid, emoji) pair. Each user can
          // write/delete their own reactions; everyone reads.
          match /reactions/{reactionId} {
            allow read: if isCrewMember();
            allow create, delete: if request.auth != null &&
              isCrewMember() &&
              reactionId.matches(request.auth.uid + '__.*');
          }
        }
      }
    }

    // News broadcast on the home page — any authed launcher reads, only
    // admins can create/edit/delete. Updates propagate live via onSnapshot
    // so changes published from the admin panel show up on every launcher
    // without requiring a relaunch.
    match /news/{newsId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      // Emoji reactions — every authed user can write their own doc;
      // they can't impersonate someone else (path uid must match auth).
      match /reactions/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete:
          if request.auth != null && request.auth.uid == uid;
      }

      // Poll votes — same per-user pattern as reactions.
      match /votes/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete:
          if request.auth != null && request.auth.uid == uid;
      }
    }

    // Modules: any authenticated user can read; admins can write.
    match /modules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Module versions: same.
    match /modules/{moduleId}/versions/{version} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Launcher release info: public read.
    match /launcher/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Server activity stats — every authed launcher client can write the
    // 5-minute player count snapshots (rate-limited client-side) and read
    // the 24h history + all-time peak. Doc IDs are sanitized address keys
    // (no user PII), so this is essentially shared community-curated data.
    match /serverStats/{addressKey} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /snapshots/{snapshotId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // Game invitations — sender writes one doc per ping, recipient (and
    // sender) can read and update its status. Strict membership: only the
    // two parties involved (`fromUid` + `toUid`) can interact with the doc.
    match /invitations/{invitationId} {
      allow read: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid;
      // Only the recipient can accept/decline; only the sender can cancel.
      // Both transitions are funneled through `setInvitationStatus`.
      allow update: if request.auth != null && (
        (resource.data.toUid == request.auth.uid &&
          request.resource.data.status in ["accepted", "declined"]) ||
        (resource.data.fromUid == request.auth.uid &&
          request.resource.data.status == "cancelled")
      );
      // No deletes — the resolved invitation stays as a tiny audit record.
      allow delete: if false;
    }

    // Crash reports — written by `sendCrashReport` from the
    // `CrashReportModal` when the user explicitly clicks "Envoyer à
    // l'admin" after a non-zero MC exit. Owner can create their own
    // (uid in body must match auth uid). Admins can read every report
    // for remote debugging. No update / delete — the report is an
    // immutable audit record.
    match /crashReports/{reportId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // App telemetry / log entries — explicit admin authorization given by
    // the user for the hidden admin logs panel ("panel admin caché que tu
    // auras accès pour voir les bugs"). Each user can write their own
    // logs (uid in body must match auth uid) and read their own logs back;
    // admins can read everything. No update/delete — logs are an
    // immutable audit trail.
    match /logs/{logId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Private 1-on-1 conversations between two launcher users. The doc id
    // is `[uidA, uidB].sort().join("__")` so participants are encoded in
    // the id itself — we extract them and require that the calling user is
    // one of them. Both reads and writes are gated on this membership so
    // a third party can't snoop on a conversation it isn't part of.
    match /conversations/{cid} {
      function isParticipant() {
        return request.auth != null && (
          // Either the auth uid appears in the doc's `participants` array
          // (set on first write by ensureConversation), or, in the no-doc
          // case (very first creation), the cid prefix matches our uid.
          (resource != null && request.auth.uid in resource.data.participants) ||
          (resource == null &&
            (cid.split("__")[0] == request.auth.uid ||
             cid.split("__")[1] == request.auth.uid))
        );
      }
      allow read: if isParticipant();
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isParticipant();
      // Delete is intentionally not allowed — conversation history is durable.

      match /messages/{messageId} {
        function isConvParticipant() {
          let parent = get(/databases/$(database)/documents/conversations/$(cid));
          return request.auth != null && request.auth.uid in parent.data.participants;
        }
        allow read: if isConvParticipant();
        allow create: if isConvParticipant() &&
          request.resource.data.senderUid == request.auth.uid;
        // Don't allow editing or deleting messages — keeps the chat audit
        // trail honest. (Edit/delete UX could be layered on later via a
        // soft-delete flag if needed.)
        allow update, delete: if false;
      }
    }
  }
}
