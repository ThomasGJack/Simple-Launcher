rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.uid in ['discord_306118713537462273'];
    }

    // Users — any authed user can read public profiles (community page),
    // only the owner can write.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Playtime per module — private to the owner
      match /playtime/{moduleId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Modules: any authenticated user can read; admins can write.
    match /modules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Module versions: same.
    match /modules/{moduleId}/versions/{version} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Launcher release info: public read.
    match /launcher/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
