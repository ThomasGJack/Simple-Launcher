# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env
.env
.env.*
!.env.example

# Tauri build artifacts
src-tauri/target/
src-tauri/gen/

# Tauri updater signing keys (NEVER commit private key!)
.tauri-keys/

# Firebase CLI cache
.firebase/

# Release build artifacts (regenerated by `npm run release:launcher`)
hosting/releases/
hosting/download/
# Velopack output : binaries are too heavy for git but the manifest
# files (releases.win.json, assets.win.json, RELEASES) are committed
# so the firebase deploy serves a coherent feed.
hosting/launcher/*/*.nupkg
hosting/launcher/*/*.exe
hosting/launcher/*/*.zip

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code internal session state (per-machine, not source)
.claude/

# Claude-flow tooling runtime state (per-session, not source)
.claude-flow/

# DepotDownloader cache (Steam depots fetched at runtime, not source)
src-tauri/depots/
