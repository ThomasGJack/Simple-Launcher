# Copier dans .env.local (gitignored)

# Firebase Web SDK config (Console Firebase > Paramètres > Vos apps > Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Discord OAuth — Client ID public (numérique)
VITE_DISCORD_CLIENT_ID=

# Discord OAuth — Client Secret (PAS de prefixe VITE !)
# Vit ici uniquement pour référence locale. Au déploiement, le secret va
# dans Firebase Functions: `firebase functions:secrets:set DISCORD_CLIENT_SECRET`
DISCORD_CLIENT_SECRET=

# CurseForge API key — pour les modpacks Minecraft
# Inscription gratuite sur https://console.curseforge.com puis génère une clé.
# Sans cette clé, les modules type Minecraft ne pourront pas télécharger les modpacks.
VITE_CURSEFORGE_API_KEY=

# Discord webhook URL pour les annonces de release (consommé par
# `npm run release:notify` après chaque firebase deploy).
#
# Setup côté Discord :
#   1. Channel → Settings → Integrations → New Webhook
#   2. Pick channel + name "Simple Launcher" + uploader le logo /logo.png
#   3. Copy Webhook URL → coller ici
#
# Le script `scripts/notify-discord.mjs` no-op silencieusement si cette
# variable n'est pas définie, donc safe de ne pas la set en dev.
DISCORD_RELEASE_WEBHOOK_URL=
